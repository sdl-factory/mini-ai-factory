# Copy to gateway/.env (never commit it) and fill in. Generate the two LiteLLM keys with:
#   printf 'sk-%s\n' "$(openssl rand -hex 32)"
# Keep LITELLM_SALT_KEY stable: changing it makes stored credentials unreadable.
LITELLM_MASTER_KEY=replace-me
LITELLM_SALT_KEY=replace-me
POSTGRES_PASSWORD=replace-me
# Your Anthropic API key (console.anthropic.com). Set a low spend limit on it there too.
ANTHROPIC_API_KEY=replace-me
